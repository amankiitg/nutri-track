# NutriTrack environment.
#
# Copy to .env and fill in. Never commit .env.
#
# Three consumers read these names:
#   - the Vite frontend         reads ONLY the VITE_* names. Vite inlines them into
#                               the browser bundle at build time, so a VITE_ name
#                               must never hold a secret.
#   - the server/ Node service  reads the SERVER-ONLY names from process.env:
#                               locally from .env, and on Render from its dashboard.
#                               server/src/config.ts validates them at boot and
#                               refuses to start if one is missing.
#   - the local invite tool     reads the two GMAIL_* names in the INVITE TOOL block
#     (tools/invite)            below, and nothing else does. It runs on a laptop and
#                               is part of no deployed service.
#
# To fill Render's environment panel, copy the SERVER-ONLY block and nothing else.


# --- Client-exposed: public, shipped to the browser --------------------------

# SUPABASE_PROJECT_ID is the project ref from the dashboard URL,
# https://supabase.com/dashboard/project/<ref>.
# The publishable key is either the new `sb_publishable_...` key or the legacy `anon` JWT.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Not read by any code. The project ref of record.
VITE_SUPABASE_PROJECT_ID=

# Where the browser POSTs a meal to be parsed: the server/ service. Locally this is
# http://localhost:8787/parse-meal; in production it is the Render service URL.
# A URL rather than a secret, which is why it takes the VITE_ prefix.
VITE_PARSE_MEAL_URL=http://localhost:8787/parse-meal
# Cloudflare Turnstile site key for the free trial (/try). Public; the secret lives
# server-side. With this empty, /try shows "Trial unavailable right now".
VITE_TURNSTILE_SITE_KEY=
# Whether /try asks for an email and a 6-digit code. False (or empty) is the anonymous
# trial: Turnstile, then a token, with no email. True restores the old flow. The server
# reports its own flag from /trial/settings and the page follows it; keep the two in step.
VITE_TRIAL_REQUIRE_EMAIL=


# --- Server-only: never prefix with VITE_ ------------------------------------

# The same Supabase project as above, under the names the Node service reads.
SUPABASE_URL=
# Public by design — the identical value the browser gets. The service needs it
# because PostgREST and Storage reject a request with no `apikey` header. It grants
# nothing on its own: every request the service makes carries the caller's own
# token, so RLS is what authorises.
SUPABASE_PUBLISHABLE_KEY=
# Not read by any code. The project ref of record.
SUPABASE_PROJECT_ID=

# Google Gemini. The API key is the only genuine secret in this file.
GEMINI_API_KEY=
# The stable model id from AI Studio, e.g. gemini-3.8-flash. One id serves
# photos and text alike, because Flash is multimodal, so there is no separate text
# model. Pin a specific stable version rather than a "latest" alias: the alias moves.
GEMINI_VISION_MODEL=gemini-3.8-flash

# Optional, and normally left empty. How much thinking a *text-only* analysis may
# do, as a token budget. Empty means the model's own minimum, which for a Gemini 3
# model is the "low" level rather than a number of tokens; setting it sends that
# count instead. Photo analyses are never given either: reading the plate is the
# part worth the tokens. A value that is not a whole number stops the service at
# boot rather than being read as the default.
TEXT_THINKING_BUDGET=

# Non-secret service configuration.
# Render injects PORT itself; this value is for local development (8080 is the
# frontend dev server).
PORT=8787
# Comma-separated. Any origin not listed is refused by CORS.
ALLOWED_ORIGINS=http://localhost:8080

# How many meal analyses one account gets per local day. The service enforces
# these, `/analysis-limit` reports them so the app cannot show a different
# number, and 0 or a typo stops the service at boot rather than being read as a
# default. Empty means the default in `shared/meal-parse.ts` (20 and 60).
DAILY_ANALYSIS_LIMIT=
ADMIN_DAILY_ANALYSIS_LIMIT=

# The free trial (/try). TURNSTILE_SECRET, TRIAL_TOKEN_SECRET and
# TRIAL_SERVER_SECRET are required; with any missing the trial endpoints answer
# "Trial unavailable right now" rather than running unprotected.
# TURNSTILE_SECRET is the Cloudflare Turnstile secret (paired with the site key above).
# TRIAL_TOKEN_SECRET signs the 30-day token, email or anonymous.
# TRIAL_SERVER_SECRET gates the trial_* database functions: the service passes it as
# p_server_secret, and the matching value lives in Supabase Vault under the name
# 'trial_server_secret'. The two must agree or every trial call is refused.
# RESEND_API_KEY is only needed for the email flow, and only when TRIAL_REQUIRE_EMAIL
# is true; the anonymous trial runs without it.
TURNSTILE_SECRET=
RESEND_API_KEY=
TRIAL_TOKEN_SECRET=
TRIAL_SERVER_SECRET=
# False (or empty) is the anonymous trial. True restores the email and code step and
# makes RESEND_API_KEY required. This is a behaviour switch, not a secret.
TRIAL_REQUIRE_EMAIL=
# The per-mailbox and global-per-day trial limits live in the database's
# trial_settings table (service_role-only write), not here.


# --- Sweeper-only ------------------------------------------------------------

# Read by server/scripts/sweep-orphan-photos.ts and by NOTHING else — not by the
# parse-meal request path, not by the frontend. Supabase dashboard -> Project
# Settings -> API -> service_role. This is the one credential in the project that
# bypasses Row Level Security.
#
# The sweeper needs it because it has to read every meal in the database to know
# which photos are still referenced. Read through RLS with a user's token, that
# query returns one user's meals and every other user's photos look like orphans.
#
# Which is exactly why it is NOT here. It lives in Render's environment, where the
# cron job is the only thing that uses it. Do not fill this line in: a laptop
# running the sweep reads every user's rows, and the privacy rule at the top of
# AGENTS.md forbids that without asking. Leave it commented; the sweeper refuses to
# start without the variable, which is the correct thing for it to do off Render.
# SUPABASE_SERVICE_ROLE_KEY=

# Dry run unless this is exactly "false". The sweeper reports what it would delete
# and deletes nothing. Anything unrecognised stops the job rather than being guessed
# at. Leave it out, or set true, until a dry run looks right.
SWEEP_DRY_RUN=true


# --- Invite tool only (tools/invite) ----------------------------------------
#
# Read by the local invite tool and by nothing else. That tool creates a Gmail
# *draft* and never sends, so this credential cannot put mail in anybody's inbox
# on its own. Run it with `npm run invite` from the repo root.
#
# GMAIL_ADDRESS is the mailbox the draft is created in. GMAIL_APP_PASSWORD is a
# Gmail app password: Google Account -> Security -> 2-Step Verification -> App
# passwords. It requires 2-Step Verification, and Google does not offer app
# passwords at all on accounts enrolled in Advanced Protection.
#
# Nothing here is prefixed VITE_, deliberately: Vite inlines those into the
# browser bundle, so a VITE_ name must never hold a secret.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

#
# ----------------------------------------------------------------------------
# The parse-meal service's Gmail credentials, which are a different thing from
# the two above. Those belong to the local tool in tools/invite, which runs on a
# laptop and drafts over IMAP. These belong to the deployed service, which drafts
# over the Gmail API so an admin can invite someone from the admin page.
#
# An OAuth refresh token, not an app password, because this one lives on Render:
# it is revocable on its own, it is scoped to gmail.compose rather than whole-
# mailbox access, and it appears as a named app in the account's third-party
# access list. `npm run gmail:consent` from server/ is the one-time step that
# produces it, and it writes the token outside this repository.
#
# In production these live in Render's environment panel and nowhere else. Set
# them locally only if you are testing the invite route against a local service.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
INVITE_SENDER_ADDRESS=
