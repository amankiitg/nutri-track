# Copy to .env and fill in. Never commit .env.
# These are public Supabase values (safe for the browser bundle).
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only values. Do NOT prefix with VITE_ — that would expose them to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
