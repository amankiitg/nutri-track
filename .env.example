# NutriTrack environment.
#
# Copy to .env and fill in. Never commit .env.
#
# Two consumers read these names:
#   - the Vite frontend         reads ONLY the VITE_* names. Vite inlines them into
#                               the browser bundle at build time, so a VITE_ name
#                               must never hold a secret.
#   - the server/ Node service  reads the SERVER-ONLY names from process.env:
#                               locally from .env, and on Render from its dashboard.
#                               server/src/config.ts validates them at boot and
#                               refuses to start if one is missing.
#
# To fill Render's environment panel, copy the SERVER-ONLY block and nothing else.


# --- Client-exposed: public, shipped to the browser --------------------------

# SUPABASE_PROJECT_ID is the project ref from the dashboard URL,
# https://supabase.com/dashboard/project/<ref>.
# The publishable key is either the new `sb_publishable_...` key or the legacy `anon` JWT.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Not read by any code. The project ref of record.
VITE_SUPABASE_PROJECT_ID=

# Where the browser POSTs a meal to be parsed: the server/ service. Locally this is
# http://localhost:8787/parse-meal; in production it is the Render service URL.
# A URL rather than a secret, which is why it takes the VITE_ prefix.
VITE_PARSE_MEAL_URL=http://localhost:8787/parse-meal


# --- Server-only: never prefix with VITE_ ------------------------------------

# The same Supabase project as above, under the names the Node service reads.
SUPABASE_URL=
# Public by design — the identical value the browser gets. The service needs it
# because PostgREST and Storage reject a request with no `apikey` header. It grants
# nothing on its own: every request the service makes carries the caller's own
# token, so RLS is what authorises.
SUPABASE_PUBLISHABLE_KEY=
# Not read by any code. The project ref of record.
SUPABASE_PROJECT_ID=

# Google Gemini. The API key is the only genuine secret in this file.
GEMINI_API_KEY=
# The stable model id from AI Studio, e.g. gemini-3.1-flash-lite. One id serves
# photos and text alike, because Flash is multimodal, so there is no separate text
# model. Pin a specific stable version rather than a "latest" alias: the alias moves.
GEMINI_VISION_MODEL=gemini-3.1-flash-lite

# Non-secret service configuration.
# Render injects PORT itself; this value is for local development (8080 is the
# frontend dev server).
PORT=8787
# Comma-separated. Any origin not listed is refused by CORS.
ALLOWED_ORIGINS=http://localhost:8080


# --- Deliberately absent -----------------------------------------------------
#
# SUPABASE_SERVICE_ROLE_KEY is not here, and the parse-meal service never reads it.
# The service verifies the caller's JWT and then uses that same token for every
# database and storage call, so RLS does the authorising and no key exists that
# could bypass it.
