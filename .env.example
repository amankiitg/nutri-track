# Copy to .env and fill in. Never commit .env.
# These are public Supabase values (safe for the browser bundle).
# SUPABASE_PROJECT_ID is the project ref from the dashboard URL,
# https://supabase.com/dashboard/project/<ref>.
# The publishable key is either the new `sb_publishable_...` key or the legacy `anon` JWT.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server-only values. Do NOT prefix with VITE_ — that would expose them to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional, and only for the Supabase CLI when applying migrations.
# Find it under Project Settings → Database → Connection string. Never commit it.
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
