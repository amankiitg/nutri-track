# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Environment files (secrets live here — never commit)
.env
.env.*
!.env.example

# Supabase CLI working files. After `supabase link` this directory holds
# pooler-url, which contains the database password in plain text.
supabase/.temp/

# The local stack the e2e suite drives: its own config and workdir, and the docker client config
# that points at colima. Local keys and local mail only, and never a copy of production's.
.e2e/
.env.e2e

# Playwright
test-results/
playwright-report/
blob-report/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
fixtures/

# Contact lists for a Resend broadcast: addresses are other people's data, and the
# template is the only part of an email that belongs in git.
emails/*.csv
email/*.csv
